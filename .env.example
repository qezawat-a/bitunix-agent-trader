NODE_ENV=production
PORT=8787
LOG_LEVEL=info

# LLM routing
AI_PROVIDER=AUTO
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=AUTO
# Compatibility aliases: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL, AI_MODEL
# The old typo OPENAI_COMPATIBALE_MODEL is also accepted.
AI_REQUEST_TIMEOUT_MS=45000
GEMINI_GOOGLE_KEY=
GEMINI_GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_GOOGLE_MODEL=AUTO
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=AUTO
THINKING_LEVEL=mid
AGENT_AUTONOMOUS_SEC=15
AGENT_MAX_TOOL_ROUNDS=8
AUTO_COMPACT=1
AUTO_COMPACT_AFTER_TURNS=40

# Long-term memory (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
STORE_ID=bitunix-main

# Bitunix Futures API — do not commit
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_REST_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Optional report destination. If empty, the first allowed /start or message persists its chat id.
TELEGRAM_CHAT_ID=
# Comma-separated Bitunix kline intervals used by the existing multi-timeframe scanner.
DEFAULT_TIMEFRAMES=1m,3m,5m,15m

# Explicit live-trading gate. Keep 0 until secrets, permissions, and limits are verified.
LIVE_TRADING=0
ARM_TRADING=0

# Runtime defaults; persistent settings are stored in Neon after first boot.
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_LEVERAGE=3
DEFAULT_MARGIN_MODE=ISOLATED
DEFAULT_POSITION_MODE=HEDGE
DEFAULT_MARGIN_AMOUNT_PCT=1
DEFAULT_MIN_CONFIDENCE=80
DEFAULT_TF_MIN_CONFIDENCE=60
DEFAULT_MIN_AGREEING_STRATEGIES=2
DEFAULT_SIGNAL_CONFIRM_SCANS=1
DEFAULT_COOLDOWN_MINUTES=5
DEFAULT_SCAN_INTERVAL_SEC=15
DEFAULT_GUARD_INTERVAL_SEC=15
DEFAULT_MID_MANAGE_INTERVAL_SEC=15
DEFAULT_REPORT_INTERVAL_SEC=30
DEFAULT_REVERSAL_ENABLED=1
DEFAULT_REVERSAL_CONFIDENCE=85
DEFAULT_BREAKEVEN_THRESHOLD_ROI=20
DEFAULT_TRAILING_TRIGGER_ROI=25
DEFAULT_LIQUIDATION_DISTANCE=0.60

# Optional MCP servers: JSON array of read-only or explicitly allowed tools
MCP_SERVERS_JSON=[]
